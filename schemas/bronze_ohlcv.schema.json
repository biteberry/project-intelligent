{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bronze OHLCV",
  "type": "object",
  "required": [
    "date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "symbol",
    "source",
    "ingestion_ts"
  ],
  "properties": {
    "date": { "type": "string", "format": "date-time" },
    "open": { "type": "number" },
    "high": { "type": "number" },
    "low": { "type": "number" },
    "close": { "type": "number" },
    "adj_close": { "type": ["number", "null"] },
    "volume": { "type": "number" },
    "symbol": { "type": "string" },
    "source": { "type": "string" },
    "ingestion_ts": { "type": "string", "format": "date-time" }
  }
}
