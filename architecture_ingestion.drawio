        <mxGeometry x="460" y="75" width="170" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="glue_etl" value="⚙️ AWS Glue Job / Lambda&#xa;&#xa;• Read from Landing&#xa;• Schema validation (G1)&#xa;• Deduplicate records&#xa;• Reject invalid rows&#xa;• Partition by source/symbol/date&#xa;• Log run to DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
