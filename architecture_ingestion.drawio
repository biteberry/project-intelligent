        <mxGeometry x="240" y="75" width="170" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="landing" value="🪣 S3: Landing Layer&#xa;s3://project-intelligent-landing/&#xa;&#xa;• Raw, unmodified data&#xa;• Partitioned by source/date&#xa;• Object Lock: COMPLIANCE&#xa;• Write-once, never modified&#xa;• Lifecycle: Glacier after 90d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#333;fontSize=10;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="1">
