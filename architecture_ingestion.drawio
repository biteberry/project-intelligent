      </mxCell>
      <mxCell id="glue_g1" value="G1 Quality Gate&#xa;Mandatory fields&#xa;No negative prices&#xa;No future dates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#C62828;fontSize=10;" vertex="1" parent="1">
        <mxGeometry x="460" y="310" width="175" height="65" as="geometry"/>
